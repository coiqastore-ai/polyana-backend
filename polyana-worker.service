[Unit]
Description=Polyana Referral Reward Worker
After=network.target postgresql.service

[Service]
Type=simple
User=polyana
WorkingDirectory=/opt/polyana-backend
Environment=DATABASE_URL=postgresql://...
ExecStart=/opt/polyana-backend/venv/bin/python worker.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
